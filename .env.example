# ——— URL publique du site (utilisée par le sitemap et les retours Stripe) ———
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ——— Paiement en ligne (optionnel) ———
# Tant que cette clé est absente, le site fonctionne en mode "règlement au comptoir" :
# la commande est enregistrée et le client paie au retrait.
#
# ⚠ Cette clé doit provenir du compte Stripe DE LA MINUTE GOURMANDE,
#   jamais de celui d'un autre projet : c'est ce compte qui reçoit les fonds
#   et qui les vire sur le RIB du client.
#   Après l'avoir renseignée : `npm run stripe:verifier` affiche à quel
#   compte elle appartient réellement.
#
# En développement, utilisez une clé sk_test_… : une clé live hors production
# est refusée par le site pour éviter tout débit réel pendant les tests.
# Clés disponibles sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Clé publique du MÊME compte et du MÊME mode que la clé secrète
# (pk_test_… avec sk_test_…, pk_live_… avec sk_live_…). Elle affiche les champs
# de paiement sur le site ; elle n'est pas secrète, mais doit correspondre.
STRIPE_PUBLISHABLE_KEY=

# Secret de signature du webhook (whsec_…), donné par Stripe à la création de
# l'endpoint https://<site>/api/stripe/webhook, avec les événements
# checkout.session.completed et checkout.session.async_payment_succeeded.
# C'est ce webhook qui prévient la boutique qu'une commande est payée.
STRIPE_WEBHOOK_SECRET=

# ——— E-mails : commandes et formulaire de contact ———
# Chaque commande est envoyée par e-mail à la boutique.
# Sans clé, les e-mails sont écrits dans les logs serveur (développement).
# ⚠ Sans domaine vérifié chez Resend, l'expéditeur onboarding@resend.dev ne
#   peut écrire qu'à l'adresse du compte Resend : créer ce compte avec
#   l'adresse qui doit recevoir les commandes.
# https://resend.com/api-keys
RESEND_API_KEY=
COMMANDES_EMAIL=minutegourmande.fwi@gmail.com
CONTACT_EMAIL=minutegourmande.fwi@gmail.com
CONTACT_FROM=Site Minute Gourmande <onboarding@resend.dev>

# ——— Référencement ———
# Par défaut, le site demande aux moteurs de recherche de NE PAS l'indexer :
# une version de validation (prix et horaires provisoires) ne doit pas
# apparaître dans Google sous le nom de la boutique.
# Passer à true uniquement pour la vraie mise en ligne.
AUTORISER_INDEXATION=false
